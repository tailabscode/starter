# Copy this file to .env and fill in your own values.
# Never commit a real key -- .env is gitignored, .env.example is not.

# Only needed for the real (non --offline) path.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Model id. Read at call time; do not append a date suffix.
ANTHROPIC_MODEL=claude-opus-5

# anthropic | stub. Defaults to anthropic when ANTHROPIC_API_KEY is set,
# otherwise falls back to stub automatically (with a log line explaining why).
LLM_PROVIDER=anthropic

LOG_LEVEL=INFO

# Where the SQLite persistent-memory database lives. Created on first use.
MEMORY_AGENT_DB=memory_agent.db

# Hashing-embedder dimensionality (pure Python, no numpy -- see README).
EMBEDDING_DIM=64

# How many persistent memories to retrieve and inject per chat turn.
RETRIEVAL_TOP_K=3

# Cosine-similarity threshold above which a proposed memory is treated as an
# update to an existing one instead of a new record.
DEDUP_THRESHOLD=0.82

# Hard cap on memory writes proposed per turn.
MAX_MEMORIES_PER_TURN=3
