# Copy this file to .env and fill in real values. Never commit .env.

# Required for the real model. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional. Defaults to claude-opus-5.
ANTHROPIC_MODEL=claude-opus-5

# Optional. "anthropic" or "stub". If unset, defaults to "anthropic" when ANTHROPIC_API_KEY is
# set, otherwise falls back to "stub" automatically (with a log line explaining why).
LLM_PROVIDER=

# Optional. Overrides where the sample corpus is read from. Defaults to ./data.
MAR_DATA_DIR=

# Optional. Overrides where run-state JSON files are written to and read from. Defaults to a
# temp directory.
MAR_RUNS_DIR=

# Optional. Max independent subtasks the coordinator may propose. Defaults to 4.
MAR_MAX_SUBTASKS=4

# Optional. Hard cap on critique-and-revise rounds. Defaults to 2.
MAR_MAX_ROUNDS=2

# Optional. Hard cap on each researcher's search-then-answer tool loop. Defaults to 3.
MAR_RESEARCHER_MAX_STEPS=3

# Optional. "true" lets researchers also use Anthropic's paid, server-executed web_search tool
# alongside the local corpus. Ignored (and logged) when running offline. Defaults to false.
ENABLE_WEB_SEARCH=false

# Optional. One of DEBUG, INFO, WARNING, ERROR. Defaults to INFO.
LOG_LEVEL=INFO
