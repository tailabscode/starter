# Copy this file to .env and fill in your own values.
# `agent-evals run` runs fully offline by default (deterministic metrics +
# a stub LLM-judge) — see "Run it" in the README. Nothing here is required
# unless you want the real Anthropic-backed groundedness judge or want the
# example agent to be answered by a live model instead of the stub.

# Get a key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Model id used for live calls (target agent responses AND the LLM-judge).
ANTHROPIC_MODEL=claude-opus-5

# anthropic | stub. Leave unset to auto-select: anthropic when
# ANTHROPIC_API_KEY is set, otherwise stub (with a log line saying so).
LLM_PROVIDER=

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
