# Copy this file to .env and fill in your own values.
# Never commit a real key -- .env is gitignored, .env.example is not.

# Only needed for the real (non --offline) path.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Model id. Read at call time; do not append a date suffix.
ANTHROPIC_MODEL=claude-opus-5

# anthropic | stub. Defaults to anthropic when ANTHROPIC_API_KEY is set,
# otherwise falls back to stub automatically (with a log line explaining why).
LLM_PROVIDER=anthropic

LOG_LEVEL=INFO

# Where the SQLite job database lives. Created on first use.
LONG_RUNNING_AGENT_DB=long_running_agent.db

# Retry/backoff and safety bounds for job execution.
MAX_RETRIES=3
RETRY_BASE_DELAY_SECONDS=0.5
MAX_WALL_CLOCK_SECONDS=300
MAX_SOURCES=25
