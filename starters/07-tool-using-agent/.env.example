# Copy this file to .env and fill in your own values.
# Every command in this starter runs fully offline without any of these —
# see "Run it" in the README.

# Get a key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Model id used for live calls.
ANTHROPIC_MODEL=claude-opus-5

# anthropic | stub. Leave unset to auto-select: anthropic when
# ANTHROPIC_API_KEY is set, otherwise stub (with a log line saying so).
LLM_PROVIDER=

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Max tool-use loop iterations before the agent gives up and returns
# a "reached max_steps" message instead of looping forever.
AGENT_MAX_STEPS=8
