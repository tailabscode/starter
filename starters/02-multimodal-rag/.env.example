# Copy this file to .env and fill in real values as needed.
# Every command in this starter also works with --offline and no keys at all.

ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-opus-5

# Optional: enables real semantic embeddings (voyage-3.5) instead of the
# offline hashing embedder. Get a key at https://dash.voyageai.com/
VOYAGE_API_KEY=pa-your-voyage-key-here

# anthropic | stub -- which LLM backend get_client() picks by default.
LLM_PROVIDER=anthropic

LOG_LEVEL=INFO
TOP_K=5
RRF_K=60
