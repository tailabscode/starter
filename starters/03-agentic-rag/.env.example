# Copy this file to .env and fill in real values. Never commit .env.

# Required for the real model. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional. Defaults to claude-opus-5.
ANTHROPIC_MODEL=claude-opus-5

# Optional. "anthropic" or "stub". If unset, defaults to "anthropic" when ANTHROPIC_API_KEY is
# set, otherwise falls back to "stub" automatically (with a log line explaining why).
LLM_PROVIDER=

# Optional. Activates VoyageEmbedder (real semantic embeddings) instead of the offline hashing
# embedder. Get one at https://dash.voyageai.com/
VOYAGE_API_KEY=

# Optional. Overrides where the sample corpus is read from. Defaults to ./data.
AGENTIC_RAG_DATA_DIR=

# Optional. Overrides where `query` writes its trace and `trace` reads it from.
AGENTIC_RAG_TRACE_PATH=

# Optional. Hard cap on agent loop steps. Defaults to 6.
AGENTIC_RAG_MAX_STEPS=6

# Optional. One of DEBUG, INFO, WARNING, ERROR. Defaults to INFO.
LOG_LEVEL=INFO
